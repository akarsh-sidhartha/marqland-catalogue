# Ignore dependencies (huge folders)
node_modules/
frontend/node_modules/
backend/node_modules/

# If you want to ignore all files inside but keep the folder structure:
backend/public/uploads/*
!backend/public/uploads/.gitkeep

# Ignore environment variables (sensitive info)
.env
.env.local

# Ignore build files
frontend/build/
frontend/dist/

# System files
.DS_Store
Thumbs.db

# Migration logs — generated by scripts/, not needed in git
backend/scripts/migration-log.json
backend/scripts/migration-vendors-portal-log.json
backend/scripts/migration-public-site-log.json

# Migration and processing logs — machine-generated, not needed in git
backend/scripts/migration-log.json
backend/scripts/migration-public-site-log.json
backend/scripts/migration-vendors-portal-log.json
backend/scripts/process-progress.json